# Telegram Bot Token (from @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ_sample

# Telegram Bot API URL
# Points to the local Telegram Bot API service in docker-compose
BOT_API_URL=http://telegram-bot-api:8081

# Telegram API credentials (for local telegram-bot-api server from my.telegram.org)
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Destination media directories (mapped in docker-compose to Jellyfin library)
MOVIES_DIR=/movies
MUSIC_DIR=/music

# Optional: Public Jellyfin URL (e.g. your static ngrok domain) for clickable watch button
JELLYFIN_URL=https://your-domain.ngrok-free.app

# Authorized Telegram User IDs (comma-separated, leave blank to allow all users)
ALLOWED_USERS=
